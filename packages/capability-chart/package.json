{
  "name": "@webpilot/capability-chart",
  "version": "0.1.0",
  "description": "Framework-neutral ECharts, Three.js and Excalidraw capability with Node and React adapters.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/excalidraw-view.js"
  ],
  "files": [
    "dist",
    "README*.md",
    "MCP*.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./runtime-skill": {
      "types": "./dist/runtime-skill.d.ts",
      "import": "./dist/runtime-skill.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./response": {
      "types": "./dist/response.d.ts",
      "import": "./dist/response.js"
    },
    "./response-react": {
      "types": "./dist/response-react.d.ts",
      "import": "./dist/response-react.js"
    },
    "./response-node": {
      "types": "./dist/response-node.d.ts",
      "import": "./dist/response-node.js"
    }
  },
  "bin": {
    "webpilot-chart-mcp": "./dist/bin/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.3",
    "@webpilot/capability-adapter-mcp": "0.1.0",
    "@webpilot/capability-sdk": "0.1.0",
    "codemirror": "^6.0.2",
    "zod": "^4.4.3",
    "@webpilot/capability-response": "0.1.0"
  },
  "peerDependencies": {
    "echarts": ">=6.0.0 <7",
    "react": ">=19.0.0 <20",
    "three": ">=0.184.0 <0.186"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
