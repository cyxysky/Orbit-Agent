{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability MCP configuration",
  "type": "object",
  "description": "按工具分组的本地 MCP 配置。省略字段使用默认值；文件中的显式值优先于环境变量。",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "编辑器使用的本地 JSON Schema 路径，不影响运行。"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "配置格式版本，必须为 1。"
    },
    "server": {
      "type": "object",
      "description": "MCP 服务级配置。路径相对于 --project 选定的项目根目录。",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "default": "capability-sdk",
          "description": "客户端显示的 MCP 服务名称。"
        },
        "skillMode": {
          "type": "string",
          "default": "eager",
          "description": "eager 在初始化时提供说明；lazy 增加 skill 工具按需读取说明。",
          "enum": [
            "eager",
            "lazy"
          ]
        },
        "stateDirectory": {
          "type": "string",
          "default": ".capability-sdk/mcp",
          "description": "MCP 文件、知识库和工作区的存储目录。不会移动已安装的 Chromium/Python 等运行环境。"
        },
        "visualization": {
          "type": "object",
          "description": "chart/maps 的 MCP Apps 内嵌界面与本地浏览器预览。无需安装另一份前端。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否提供可视化界面；false 时只返回原有工具数据。"
            },
            "preview": {
              "type": "boolean",
              "default": true,
              "description": "提供带随机访问令牌的 127.0.0.1 浏览器预览链接；链接在 MCP 进程退出后失效。"
            },
            "port": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 65535,
              "description": "本地预览端口；0 自动分配，避免多个 agent 冲突。仅监听 127.0.0.1。"
            },
            "readOnly": {
              "type": "boolean",
              "default": false,
              "description": "禁止预览页面写回服务器；仍可临时编辑和导出，不改变 agent 调用 chart update 的权限。"
            },
            "staticImages": {
              "type": "boolean",
              "default": true,
              "description": "为二维 ECharts 生成 PNG 回填；其他引擎保留交互页面和文字/链接，避免自动启动额外浏览器。"
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "description": "只配置需要调整的字段，其余使用默认值。业务 Provider 仍可通过显式 .mjs 扩展。",
      "additionalProperties": false,
      "properties": {
        "browser": {
          "type": "object",
          "description": "一个 browser 工具，action 为 open/code/snapshot/close。配置共享于此 MCP 的浏览器会话。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否注册该工具；false 时不加载模块，不向 MCP 客户端暴露此工具。修改后重启 MCP。"
            },
            "headless": {
              "type": "boolean",
              "default": true,
              "description": "true 隐藏浏览器窗口；false 显示窗口。覆盖 HEADLESS_BROWSER/BROWSER_HEADLESS。"
            },
            "isolated": {
              "type": "boolean",
              "default": true,
              "description": "true 使用隔离会话与随包 Chromium，忽略外部 CDP 和用户配置目录。使用 cdpEndpoint/userDataDir 时必须设为 false。"
            },
            "maxSessions": {
              "type": "integer",
              "default": 8,
              "minimum": 1,
              "maximum": 100,
              "description": "同时打开的 browser 会话上限；超过后 open 返回容量错误。复用固定用户配置目录时应设为 1。"
            },
            "idleTimeoutMs": {
              "type": "integer",
              "default": 900000,
              "minimum": 0,
              "maximum": 86400000,
              "description": "会话空闲回收时间（毫秒）；0 禁用回收。执行中的调用不会因空闲超时被关闭。"
            },
            "slowMoMs": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 10000,
              "description": "浏览器操作延迟（毫秒），用于观察操作过程；不等同于导航超时。"
            },
            "viewport": {
              "type": "object",
              "description": "控制网页 CSS 视口，而非截图像素尺寸。",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "default": "auto",
                  "description": "auto 按浏览器运行方式选择视口；fixed 使用下面的 width/height。",
                  "enum": [
                    "auto",
                    "fixed"
                  ]
                },
                "width": {
                  "type": "integer",
                  "default": 1440,
                  "minimum": 1,
                  "maximum": 16384,
                  "description": "fixed 模式的视口宽度（CSS 像素）。"
                },
                "height": {
                  "type": "integer",
                  "default": 900,
                  "minimum": 1,
                  "maximum": 16384,
                  "description": "fixed 模式的视口高度（CSS 像素）。"
                }
              }
            },
            "ignoreHTTPSErrors": {
              "type": "boolean",
              "default": false,
              "description": "是否忽略 HTTPS 证书错误。仅在需要访问对应测试环境时开启。"
            },
            "screenshotTimeoutMs": {
              "type": "integer",
              "default": 15000,
              "minimum": 1000,
              "maximum": 120000,
              "description": "单次截图超时（毫秒）。"
            },
            "outputPixelRatio": {
              "type": "number",
              "default": 1.5,
              "minimum": 1,
              "maximum": 2,
              "description": "截图输出像素倍率，不改变网页 CSS 视口。"
            },
            "domQuietMs": {
              "type": "integer",
              "default": 250,
              "minimum": 0,
              "maximum": 60000,
              "description": "导航后等待 DOM 连续稳定的时间窗口（毫秒）。"
            },
            "domStabilityTimeoutMs": {
              "type": "integer",
              "default": 1000,
              "minimum": 0,
              "maximum": 120000,
              "description": "导航后等待 DOM 稳定的最长时间（毫秒）。"
            },
            "executablePath": {
              "type": "string",
              "default": "",
              "description": "指定 Chromium 可执行文件；空字符串使用项目内已安装的 Chromium。相对路径按项目根目录解析。"
            },
            "cdpEndpoint": {
              "type": "string",
              "default": "",
              "description": "连接已启动浏览器的 CDP 地址；需 isolated=false。不会自动安装或启动外部浏览器。"
            },
            "userDataDir": {
              "type": "string",
              "default": "",
              "description": "持久化浏览器配置目录，保存登录态；需 isolated=false、maxSessions=1，且不与 cdpEndpoint 同时设置。相对路径按项目根目录解析。"
            }
          }
        },
        "terminal": {
          "type": "object",
          "description": "项目本地终端；以当前用户权限执行，不提供 OS 隔离。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否注册该工具；false 时不加载模块，不向 MCP 客户端暴露此工具。修改后重启 MCP。"
            },
            "cwd": {
              "type": "string",
              "default": ".",
              "description": "终端工作目录，相对于项目根目录。"
            },
            "shell": {
              "type": "string",
              "default": "auto",
              "description": "auto 在 Windows 使用 PowerShell，Linux 使用 Bash；选择 pwsh 时需自行安装 PowerShell 7。",
              "enum": [
                "auto",
                "powershell",
                "pwsh",
                "bash",
                "sh"
              ]
            },
            "timeoutMs": {
              "type": "integer",
              "default": 120000,
              "minimum": 1000,
              "maximum": 3600000,
              "description": "命令最长运行时间（毫秒），工具调用可请求更短时间。"
            },
            "maxOutputChars": {
              "type": "integer",
              "default": 50000,
              "minimum": 1000,
              "maximum": 500000,
              "description": "每个进程的输出缓冲字符上限。"
            },
            "maxProcesses": {
              "type": "integer",
              "default": 4,
              "minimum": 1,
              "maximum": 16,
              "description": "此 MCP 实例的终端并发进程上限。"
            }
          }
        },
        "code": {
          "type": "object",
          "description": "codeSandbox：本地 JavaScript/Python 执行与产物保存。临时工作区按执行器隔离。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否注册该工具；false 时不加载模块，不向 MCP 客户端暴露此工具。修改后重启 MCP。"
            },
            "timeoutMs": {
              "type": "integer",
              "default": 30000,
              "minimum": 1000,
              "maximum": 300000,
              "description": "单次代码执行超时（毫秒）。"
            },
            "installTimeoutMs": {
              "type": "integer",
              "default": 120000,
              "minimum": 5000,
              "maximum": 300000,
              "description": "依赖安装与执行共享的时间预算（毫秒）。"
            },
            "maxOutputChars": {
              "type": "integer",
              "default": 30000,
              "minimum": 1000,
              "maximum": 200000,
              "description": "stdout/stderr 合计字符上限；输出文件通过独立产物通道保存。"
            },
            "maxConcurrent": {
              "type": "integer",
              "default": 2,
              "minimum": 1,
              "maximum": 16,
              "description": "本地代码执行器的并发任务上限。"
            },
            "allowPackageInstall": {
              "type": "boolean",
              "default": true,
              "description": "是否允许代码任务安装固定版本的 npm/Python 包。"
            },
            "maxPackages": {
              "type": "integer",
              "default": 16,
              "minimum": 0,
              "maximum": 32,
              "description": "单次任务最多安装的依赖数量。"
            }
          }
        },
        "file": {
          "type": "object",
          "description": "文件读写、Office 生成和转换。visual QA 需要具备图像能力的宿主单独接入。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否注册该工具；false 时不加载模块，不向 MCP 客户端暴露此工具。修改后重启 MCP。"
            },
            "officeGenerationMode": {
              "type": "string",
              "default": "uno",
              "description": "uno 使用 LibreOffice；javascript 使用 ExcelJS/HTML 文档管线；auto 由现有文件工具选择。",
              "enum": [
                "uno",
                "javascript",
                "auto"
              ]
            }
          }
        },
        "chart": {
          "type": "object",
          "description": "图表创建、读取和更新；产物保存在 server.stateDirectory/artifacts/charts。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否注册该工具；false 时不加载模块，不向 MCP 客户端暴露此工具。修改后重启 MCP。"
            },
            "retainedRevisions": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 1000,
              "description": "每张图表保留的历史修订数量。"
            }
          }
        },
        "maps": {
          "type": "object",
          "description": "可选 Google Maps 工具；show 无密钥可生成位置示意，搜索/路线需要服务端 Key，底图需要浏览器 Key。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "是否启用 maps；默认不启用。"
            },
            "browserKeyEnv": {
              "type": "string",
              "default": "GOOGLE_MAPS_BROWSER_KEY",
              "description": "Maps JavaScript API 浏览器 Key 所在环境变量名；该 Key 会提供给页面，需限制网站来源。"
            },
            "serverKeyEnv": {
              "type": "string",
              "default": "GOOGLE_MAPS_SERVER_KEY",
              "description": "Places/Routes 服务端 Key 所在环境变量名；不会发送给预览页面。"
            },
            "language": {
              "type": "string",
              "default": "zh-CN",
              "description": "地图语言，例如 zh-CN、en。"
            },
            "searchMonthlyLimit": {
              "type": "integer",
              "default": 4500,
              "minimum": 0,
              "maximum": 100000,
              "description": "项目内每月搜索调用上限；0 停用搜索。"
            },
            "routesMonthlyLimit": {
              "type": "integer",
              "default": 9000,
              "minimum": 0,
              "maximum": 100000,
              "description": "项目内每月路线调用上限；0 停用路线。"
            }
          }
        },
        "knowledge": {
          "type": "object",
          "description": "持久化参考资料知识库；保存在 server.stateDirectory/knowledge。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否注册该工具；false 时不加载模块，不向 MCP 客户端暴露此工具。修改后重启 MCP。"
            },
            "chunkChars": {
              "type": "integer",
              "default": 1800,
              "minimum": 400,
              "maximum": 8000,
              "description": "全文索引每个分块的目标字符数。"
            },
            "searchLimit": {
              "type": "integer",
              "default": 8,
              "minimum": 1,
              "maximum": 30,
              "description": "知识检索默认返回条数。"
            }
          }
        },
        "media": {
          "type": "object",
          "description": "默认实现本地媒体检查和视频抽帧；OCR/转写/生成需业务 Provider，不会自动接入模型。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否注册该工具；false 时不加载模块，不向 MCP 客户端暴露此工具。修改后重启 MCP。"
            },
            "timeoutMs": {
              "type": "integer",
              "default": 120000,
              "minimum": 1000,
              "maximum": 900000,
              "description": "FFmpeg 处理超时（毫秒）；媒体头检查最长 15 秒。"
            },
            "maxFrames": {
              "type": "integer",
              "default": 12,
              "minimum": 1,
              "maximum": 60,
              "description": "每次抽帧最多生成的帧数。"
            }
          }
        },
        "computer": {
          "type": "object",
          "description": "Windows 内置桌面驱动，或自行配置的远程驱动。其他平台无 endpoint 时默认不注册。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "默认自动判断平台：Windows 或配置 endpoint 时启用。显式 false 禁用；不支持的平台显式 true 会报错。"
            },
            "endpoint": {
              "type": "string",
              "default": "",
              "description": "外部桌面驱动地址；空字符串在 Windows 使用内置驱动。"
            },
            "authorizationEnv": {
              "type": "string",
              "default": "",
              "description": "包含外部驱动 Authorization 值的环境变量名称；不在 JSON 中保存密钥。"
            },
            "timeoutMs": {
              "type": "integer",
              "default": 30000,
              "minimum": 1000,
              "maximum": 300000,
              "description": "单次桌面操作超时（毫秒）。"
            }
          }
        }
      }
    }
  }
}
