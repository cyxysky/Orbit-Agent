# Deployment only. Configure models, tools, MCP, context, memory and UI in Settings.
# Business settings are persisted in the database and update without restarting Orbit.

# Service deployment
HOSTNAME=127.0.0.1
PORT=3000
# Empty uses <project>/runtime. Keep the data directory across upgrades.
APP_DATA_DIR=
ORBIT_BASE_PATH=/orbit
ORBIT_API_HEAP_MB=1024
# Allow database upgrades to finish before the API supervisor considers startup failed.
ORBIT_API_STARTUP_TIMEOUT_MS=600000
ORBIT_EXECUTION_HEAP_MB=4096
ORBIT_INTERRUPT_GRACE_MS=5000
ORBIT_DEBUG_ROUTES_ENABLED=false
ORBIT_TRUST_PROXY=false
# Independent startup permissions. Extensions do not grant local shell access.
ORBIT_SELF_BOOTSTRAP_ENABLED=false
# Local terminal/computer/code execution and application-managed local Runners.
ORBIT_HOST_EXECUTION_ENABLED=false
# Optional font files provided by a custom deployment image.
ORBIT_DOCUMENT_FONT=
ORBIT_DOCUMENT_FONT_FAMILY=
# Independent Runner service deployment. Tool settings can override the URL.
# ORBIT_CODE_SANDBOX_SERVICE_URL=http://webpilot-code-sandbox:18100
CODE_SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-token
# Optional installed browser binary. User browser settings take precedence.
# ORBIT_BROWSER_EXECUTABLE_PATH=

# Database deployment
DATABASE_DRIVER=sqlite
SQLITE_DATABASE_PATH=
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_app_test
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_LOGGING=false
DATABASE_BUSY_TIMEOUT_MS=5000

# Identity and administration
# Default resource owner for server-side operations; never grants anonymous access.
ORBIT_DEFAULT_USER_ID=1
# Bind each user through /api/browser-cookies/domp before enabling this check.
ORBIT_USER_COOKIE_CHECK_ENABLED=false
# Optional comma-separated login cookie names; otherwise compare all non-Orbit cookies.
ORBIT_USER_COOKIE_NAMES=
ORBIT_CROSS_SITE_MOUNT=false
ORBIT_WEBSOCKET_TICKET_TTL_SECONDS=45
ORBIT_ADMIN_SETTINGS_PASSWORD_ENABLED=true
# Required when enabled: /login issues an 8-hour HttpOnly administrator session.
# false disables administrator login; it does not enable anonymous administrator access.
ORBIT_ADMIN_SETTINGS_PASSWORD=

# Optional MCP tool installation storage and npm registry. Empty uses the defaults.
CAPABILITY_TOOLS_HOME=
CAPABILITY_TOOL_REGISTRY=https://registry.npmjs.org
