{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/capability-sdk"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "main": "electron/main.js",
  "scripts": {
    "code-sandbox:start": "node server/start-code-sandbox-runner.js",
    "dev": "node --max-old-space-size=8144 server/webpilot-server.js --dev",
    "sensitive-data:install": "npm run install-runtime --workspace @cjfclonedeep/capability-sdk",
    "sensitive-data:start": "npm run start-runtime --workspace @cjfclonedeep/capability-sdk",
    "sensitive-data:bundle": "npm run bundle-runtime --workspace @cjfclonedeep/capability-sdk",
    "build": "npm run backend:build && next build",
    "server:package": "npm run build && npm run sensitive-data:bundle && node scripts/package-server.js",
    "server:installer": "npm run server:package && node scripts/package-server-installer.js",
    "desktop:prepare": "npm run build && npm run sensitive-data:bundle && node scripts/prepare-electron-server.js",
    "desktop:pack": "npm run desktop:installer",
    "desktop:installer": "npm run desktop:prepare && electron-builder --win nsis",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable",
    "start": "node server/webpilot-server.js",
    "capabilities:build": "npm run build --workspace @cjfclonedeep/capability-sdk",
    "capabilities:publish": "node scripts/publish-capabilities.mjs",
    "capabilities:publish:dry-run": "node scripts/publish-capabilities.mjs --dry-run",
    "check:responsive": "node scripts/check-responsive-ui.mjs",
    "docker:build": "docker build -t orbit:latest .",
    "docker:up": "docker compose up -d --build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "backend:build": "node scripts/build-backend.mjs",
    "backend:check": "node scripts/build-backend.mjs --check",
    "backend:typecheck": "tsc -p tsconfig.backend.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.30",
    "@ai-sdk/amazon-bedrock": "^5.0.51",
    "@ai-sdk/anthropic": "^4.0.37",
    "@ai-sdk/azure": "^4.0.38",
    "@ai-sdk/cerebras": "^3.0.29",
    "@ai-sdk/cohere": "^4.0.26",
    "@ai-sdk/deepinfra": "^3.0.29",
    "@ai-sdk/deepseek": "^3.0.27",
    "@ai-sdk/fireworks": "^3.0.31",
    "@ai-sdk/gateway": "^4.0.47",
    "@ai-sdk/google": "^4.0.40",
    "@ai-sdk/groq": "^4.0.27",
    "@ai-sdk/huggingface": "^2.0.29",
    "@ai-sdk/mistral": "^4.0.28",
    "@ai-sdk/openai": "^4.0.37",
    "@ai-sdk/openai-compatible": "^3.0.29",
    "@ai-sdk/otel": "^1.0.59",
    "@ai-sdk/perplexity": "^4.0.28",
    "@ai-sdk/provider": "^4.0.7",
    "@ai-sdk/react": "4.0.62",
    "@ai-sdk/togetherai": "^3.0.30",
    "@ai-sdk/vercel": "^3.0.29",
    "@ai-sdk/xai": "^4.0.34",
    "@cjfclonedeep/capability-sdk": "0.2.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@lobehub/icons-static-png": "^1.75.0",
    "@next/env": "^16.3.0",
    "@open-file-viewer/core": "^0.1.42",
    "@open-file-viewer/react": "^0.1.42",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-virtual": "^3.14.3",
    "ai": "^7.0.59",
    "ai-sdk-provider-codex-cli": "^2.1.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "ffmpeg-static": "^5.3.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.511.0",
    "mdast-util-from-markdown": "^2.0.3",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "playwright": "^1.60.0",
    "prismjs": "1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "three": "~0.184.0",
    "typeorm": "^1.1.1",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.24",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "~0.184.0",
    "app-builder-lib": "^26.15.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.webpilotqa.desktop",
    "productName": "Orbit",
    "asar": true,
    "npmRebuild": true,
    "beforeBuild": "scripts/electron-before-build.js",
    "afterPack": "scripts/electron-after-pack.js",
    "directories": {
      "app": "electron",
      "output": "dist-electron"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "dist-desktop/server",
        "to": "server"
      },
      {
        "from": "assets/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "assets/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Orbit-Setup-${version}-${arch}.${ext}",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "runAfterFinish": true
    }
  }
}
