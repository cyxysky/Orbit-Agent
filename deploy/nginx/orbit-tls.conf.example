# Optional external TLS gateway. This file is NOT loaded by the Pod's Nginx.
# Replace the upstream address, domain and certificate paths before nginx -t.
map $http_upgrade $orbit_tls_connection_upgrade {
    default upgrade;
    '' close;
}

upstream orbit_cluster {
    # Use the node currently running the Orbit Pod (externalTrafficPolicy: Local).
    server K8S_WORKER_ADDRESS:30080;
    keepalive 16;
}

server {
    listen 80;
    server_name orbit.example.internal;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name orbit.example.internal;
    ssl_certificate /etc/nginx/tls/orbit.crt;
    ssl_certificate_key /etc/nginx/tls/orbit.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 100m;

    location / {
        proxy_pass http://orbit_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $orbit_tls_connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
